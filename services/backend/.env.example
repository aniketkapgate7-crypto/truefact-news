# Application
APP_NAME=TrueFact News API
APP_ENV=development
DEBUG=false
DOCS_ENABLED=true

# Temporary Local Mutation & Workspace Controls (Default: false)
ENABLE_EDITORIAL_WORKSPACE=false
ENABLE_EDITORIAL_MUTATIONS=false
ENABLE_ADMIN_MUTATIONS=false

# Authentication Settings (Clerk OIDC - Default: false)
AUTH_ENABLED=false
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWKS_TIMEOUT_SECONDS=5
CLERK_JWKS_CACHE_TTL_SECONDS=3600

# Database
DATABASE_URL=sqlite:///./truefact_news.db

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Fact Check Tools API (Optional placeholder)
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_BASE_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search
GOOGLE_FACT_CHECK_TIMEOUT_SECONDS=10
GOOGLE_FACT_CHECK_LANGUAGE_CODE=en

# Billing
BILLING_ENABLED=false
BILLING_PROVIDER=razorpay
BILLING_MAX_WEBHOOK_BYTES=262144
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
INTERNAL_CRON_SECRET=
RAZORPAY_PLAN_ID_PRO_MONTHLY=
RAZORPAY_PLAN_ID_PRO_ANNUAL=
